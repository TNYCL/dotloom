{
  "name": "@dotloom/react",
  "version": "0.1.0",
  "description": "Optional React editor for Dotloom: canvas, toolbar, layers, objects, inspector, constraints, command palette",
  "license": "MIT OR Apache-2.0",
  "author": "TNYCL",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TNYCL/dotloom.git",
    "directory": "packages/react"
  },
  "homepage": "https://tnycl.github.io/dotloom/",
  "keywords": [
    "cad",
    "constraints",
    "editor",
    "react",
    "wasm",
    "webgpu"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE-MIT",
    "LICENSE-APACHE",
    "README.md"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs react",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@dotloom/sdk": "workspace:^"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
